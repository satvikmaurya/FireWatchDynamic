{
  "name": "mountain-lake-watchface",
  "author": "Satvik Maurya",
  "version": "1.0.7",
  "keywords": ["pebble-app"],
  "private": true,
  "dependencies": {
    "@rebble/clay": "*"
  },
  "pebble": {
    "displayName": "Mountain Lake",
    "uuid": "0de960fa-1ad2-4fa7-af23-b50442caf56a",
    "sdkVersion": "3",
    "enableMultiJS": true,
    "watchapp": {
      "watchface": true
    },
    "capabilities": ["health", "configurable", "location"],
    "messageKeys": [
      "REQUEST_WEATHER",
      "TEMPERATURE",
      "CONDITIONS",
      "SUNRISE",
      "SUNSET",
      "TEMP_UNIT",
      "TIME_FORMAT",
      "WEATHER_PROVIDER",
      "OWM_API_KEY",
      "WEATHERAPI_KEY"
    ],
    "targetPlatforms": ["emery"],
    "resources": {
      "media": [
        {"type":"bitmap","name":"SCENE_NIGHT_CLEAR","file":"scene_night_clear.png"},
        {"type":"bitmap","name":"SCENE_NIGHT_CLOUD","file":"scene_night_cloud.png"},
        {"type":"bitmap","name":"SCENE_NIGHT_RAIN", "file":"scene_night_rain.png"},
        {"type":"bitmap","name":"SCENE_NIGHT_SNOW", "file":"scene_night_snow.png"},
        {"type":"bitmap","name":"SCENE_DAWN_CLEAR", "file":"scene_dawn_clear.png"},
        {"type":"bitmap","name":"SCENE_DAWN_RAIN",  "file":"scene_dawn_rain.png"},
        {"type":"bitmap","name":"SCENE_DAY_CLEAR",  "file":"scene_day_clear.png"},
        {"type":"bitmap","name":"SCENE_DAY_PARTLY", "file":"scene_day_partly.png"},
        {"type":"bitmap","name":"SCENE_DAY_CLOUD",  "file":"scene_day_cloud.png"},
        {"type":"bitmap","name":"SCENE_DAY_RAIN",   "file":"scene_day_rain.png"},
        {"type":"bitmap","name":"SCENE_DAY_STORM",  "file":"scene_day_storm.png"},
        {"type":"bitmap","name":"SCENE_DAY_SNOW",   "file":"scene_day_snow.png"},
        {"type":"bitmap","name":"SCENE_DUSK_CLEAR", "file":"scene_dusk_clear.png"},
        {"type":"bitmap","name":"SCENE_DUSK_RAIN",  "file":"scene_dusk_rain.png"},
        {"type":"bitmap","name":"SCENE_DUSK_SNOW",  "file":"scene_dusk_snow.png"},
        {"type":"bitmap","name":"ICON_STEPS",  "file":"steps.png"},
        {"type":"bitmap","name":"ICON_TEMP",  "file":"temp.png"},
        {"type":"bitmap","name":"ICON_HEART",  "file":"heart.png"}
      ]
}
  }
}